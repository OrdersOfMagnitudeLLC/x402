{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OrdersOfMagnitudeLLC/mcp-package",
  "description": "MCP server for OOM x402 search 1,000+ pay-per-call API endpoints",
  "repository": {
    "url": "https://github.com/OrdersOfMagnitudeLLC/x402",
    "source": "github",
    "subfolder": "mcp-package"
  },
  "version": "1.0.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "oom-x402-mcp",
      "version": "1.0.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for the service",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "YOUR_API_KEY"
        }
      ]
    }
  ]
}
